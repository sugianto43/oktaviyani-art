# Canonical site URL, no trailing slash — used for canonical links, sitemap,
# robots.txt, and Open Graph/Twitter metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project ID and dataset are not secrets — safe as NEXT_PUBLIC_*.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Write token (Settings -> API -> Tokens, "Editor" role is enough).
# Server-only, used by `pnpm seed` to import mock content — never expose
# this as NEXT_PUBLIC_*.
SANITY_API_WRITE_TOKEN=
